# Backend only. Copy Supabase's session-pooler URI and encode its password.
# Leave sslmode/sslcert/sslrootcert/sslkey out of the URI; TLS is configured below.
DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres
DB_SSL=true
# If needed, download Supabase's database CA certificate and set this path.
# DB_SSL_CA_PATH=./certs/supabase-ca.crt
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
GEMINI_API_KEY=
RESEND_API_KEY=
EMAIL_USER=
SEMAPHORE_API_KEY=
LANDLORD_PHONE_NUMBER=
SEMAPHORE_SENDER_NAME=dormfix

# For a local PostgreSQL instance only:
# DATABASE_URL=postgresql://postgres:ENCODED_PASSWORD@localhost:5432/dormfix
# DB_SSL=false
